      }
    },
    "similarity": "difflib.SequenceMatcher(None, a, b, autojunk=False) egyező-karakter arány, 2*M/(|a|+|b|); a = a korábbi rekord",
    "normalization": {
      "nfc": true,
      "typographic_quotes_dashes": true,
      "list_markers_removed": true,
